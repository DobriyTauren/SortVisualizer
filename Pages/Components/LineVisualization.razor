@using Blazored.LocalStorage
@using SortVisualizer.Client.Classes
@using SortVisualizer.Client.Classes.SortElements

@inject UserDataStorage userData
@inject ILocalStorageService localStorage
@inject IndexedDB indexDB
@implements IDisposable

<div class="main-container bdr block-bg-color mb-3">
    <div class="sort-block-container">
        <div class="container">
            <div class="row">
                <div class="col-sm mb-2 mx-2 info-control-color rounded">
                    <p class="text-center my-auto">Обращений к массиву: @SortAlgorithm.ArrayAccessCount</p>
                </div>
                <div class="col mb-2 mx-2 info-control-color rounded">
                    <p class="text-center my-auto">Перестановок: @SortAlgorithm.MoveCount</p>
                </div>
                <div class="col mb-2 mx-2 info-control-color rounded">
                    <p class="text-center my-auto">Время: @FormatMs(_computeMs)</p>
                </div>
            </div>
        </div>

        <svg width="100%" height="58vh" shape-rendering="@BarShapeRendering" class="mx-2 svg-container bars-svg @(BarGlow ? "bars-glow" : null)" style="--move-dur: @(userData.PlaybackSpeedMs)ms;">
            @foreach (var line in _arrayElements)
            {
                <line class="@(_animate ? "bar-move" : null)"
                      x1="@($"{BarX(line)}%".Replace(",", "."))" y1="@($"{line.StartPoint.Y}%".Replace(",", "."))"
                      x2="@($"{BarX(line)}%".Replace(",", "."))" y2="@($"{line.EndPoint.Y}%".Replace(",", "."))"
                      stroke-width="@($"{_generator.LineWidthPercentage * BarWidthFactor}%".Replace(",","."))" stroke="@line.Color" stroke-linecap="@BarCap"
                      style="@BarTransform(line)">

                </line>
            }
        </svg>

        @if (_isPreparing)
        {
            <div class="preparing mx-2 mb-3"><span class="prep-spinner"></span> Подготовка анимации…</div>
        }

        @if (_player != null)
        {
            <div class="transport mx-2 mb-3">
                <button class="tbtn" title="В начало" @onclick="Restart" disabled="@_player.IsAtStart">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M4 4a.5.5 0 0 1 1 0v3.248l6.267-3.636c.54-.313 1.232.066 1.232.696v7.384c0 .63-.692 1.01-1.232.697L5 8.752V12a.5.5 0 0 1-1 0z"/></svg>
                </button>
                <button class="tbtn" title="Шаг назад" @onclick="StepBack" disabled="@_player.IsAtStart">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M3.86 8.753l5.482 4.796c.646.566 1.658.106 1.658-.753V3.204a1 1 0 0 0-1.659-.753l-5.48 4.796a1 1 0 0 0 0 1.506z"/></svg>
                </button>
                <button class="tbtn tbtn-main" title="@(_player.IsPlaying ? "Пауза" : "Воспроизвести")" @onclick="TogglePlay">
                    @if (_player.IsPlaying)
                    {
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 3.5A1.5 1.5 0 0 1 7 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5m5 0A1.5 1.5 0 0 1 12 5v6a1.5 1.5 0 0 1-3 0V5a1.5 1.5 0 0 1 1.5-1.5"/></svg>
                    }
                    else
                    {
                        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="m11.596 8.697-6.363 3.692C4.713 12.69 4 12.345 4 11.692V4.308c0-.653.713-.998 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/></svg>
                    }
                </button>
                <button class="tbtn" title="Шаг вперёд" @onclick="StepForward" disabled="@_player.IsFinished">
                    <svg width="18" height="18" viewBox="0 0 16 16" fill="currentColor"><path d="M12.14 8.753 6.658 13.549c-.646.566-1.658.106-1.658-.753V3.204a1 1 0 0 1 1.659-.753l5.48 4.796a1 1 0 0 1 0 1.506z"/></svg>
                </button>

                <input type="range" class="progress-range" min="0" max="@_player.Total" value="@_player.Index" @oninput="OnSeek" />
                <span class="frame-counter">@_player.Index / @_player.Total</span>

                <select class="speed-select" @bind="SpeedMs" @bind:after="SaveSpeed" title="Скорость анимации">
                    @foreach (var p in _speedPresets)
                    {
                        <option value="@p.Ms">@p.Label</option>
                    }
                </select>
            </div>
        }

        <div class="row btn-container">
            <div class="col-auto">
                <button class="btn" @onclick="GenerateArray" disabled="@IsBusy">Сгенерировать</button>
            </div>
            <div class="col-auto mb-2">
                <button class="btn" @onclick="SortArray" disabled="@(_isEmpty || _isRecorded || IsBusy)">Сортировать</button>
            </div>

            <div class="col-auto pt-2">
                <p class="text-center">Элементов</p>
            </div>
            <div class="col-auto mb-4 w-7">
                <input @bind="@userData.ItemsCount" disabled="@(_isRecorded || IsBusy)" type="text" class="form-control" placeholder="Элементов">
            </div>
        </div>
    </div>
</div>

@code
{
    [Inject]
    private IJSRuntime JSRuntime { get; set; }

    [Parameter]
    public SortAlgorithm SortAlgorithm { get; set; }

    [Parameter]
    public EventCallback IsSortingCallback { get; set; }

    private Generator _generator = new Generator();

    private List<SvgLine> _arrayElements = new List<SvgLine>();
    private SortPlayer? _player;

    private const int AnimateMaxCount = 150;

    private bool _isEmpty = true;
    private bool _isRecorded = false;
    private bool _isPreparing = false;
    private bool _useTransform = false;  // bars positioned via transform (animatable layout)
    private bool _animate = false;       // transition (gliding) currently enabled
    private int _algorithmId = 0;

    private bool IsBusy => _isPreparing || (_player != null && _player.IsPlaying);

    // real algorithm time (ms), measured by Stopwatch on a recording-free pass
    private double _computeMs;

    private string FormatMs(double ms)
    {
        var ci = System.Globalization.CultureInfo.InvariantCulture;
        if (ms <= 0) return "0 мс";
        if (ms < 1) return ms.ToString("0.000", ci) + " мс";
        if (ms < 100) return ms.ToString("0.00", ci) + " мс";
        return ms.ToString("0", ci) + " мс";
    }

    // Bars get denser/cleaner as the count grows: thick rounded glowing bars when few,
    // thin contiguous flat bars (no glow, pixel-snapped) when many — avoids the moiré shimmer.
    private int BarCount => _arrayElements.Count;
    private double BarWidthFactor => BarCount <= 30 ? 0.62 : (BarCount <= 200 ? 0.82 : 1.0);
    private string BarCap => BarCount > 200 ? "butt" : "round";
    private bool BarGlow => BarCount <= 30;
    private string BarShapeRendering => BarCount > 200 ? "crispEdges" : "geometricPrecision";

    // While animating, bars sit at their home column and slide via transform (CSS-animatable).
    // Otherwise they're drawn at the current column directly (keeps crispEdges pixel-snapping).
    private double BarX(SvgLine line) => _useTransform ? line.FixedStartPoint.X : line.StartPoint.X;

    private string? BarTransform(SvgLine line)
    {
        if (!_useTransform) return null;
        var dx = (line.StartPoint.X - line.FixedStartPoint.X) * _generator.ContainerWidth / 100d;
        return $"transform: translateX({dx.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}px);";
    }

    private readonly (string Label, int Ms)[] _speedPresets =
    {
        ("0.25×", 120),
        ("0.5×", 60),
        ("1×", 30),
        ("2×", 15),
        ("4×", 8),
        ("8×", 3),
    };

    // playback speed is remembered in UserDataStorage (and persisted to localStorage)
    private int SpeedMs
    {
        get => _player?.Delay ?? userData.PlaybackSpeedMs;
        set
        {
            userData.PlaybackSpeedMs = value;
            if (_player != null) _player.Delay = value;
        }
    }

    private async Task SaveSpeed() => await userData.SavePlaybackSpeed(localStorage);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await userData.LoadPlaybackSpeed(localStorage);

            // auto-generate the starting array as soon as the page opens (bars visible by default)
            if (_isEmpty)
                await GenerateArray();

            StateHasChanged();
        }
    }

    private async Task GenerateArray()
    {
        if (_player != null) _player.Pause();
        _player = null;
        _isRecorded = false;

        _arrayElements.Clear();

        // On a cold / direct page load the svg may not be laid out yet (width 0), which
        // makes GenerateLines divide by zero and collapse every bar into one. Wait for a
        // real width before generating.
        int width = 0, height = 0;
        for (int attempt = 0; attempt < 10; attempt++)
        {
            width = await JSRuntime.InvokeAsync<int>("svgInterop.getSvgWidth", 0);
            height = await JSRuntime.InvokeAsync<int>("svgInterop.getSvgHeight", 0);
            if (width > 50) break;
            await Task.Delay(80);
        }

        _generator.ContainerWidth = width;
        _generator.ContainerHeight = height;

        _arrayElements = _generator.GenerateLines(userData.ItemsCount);

        _isEmpty = false;
    }

    private async Task SortArray()
    {
        _algorithmId = userData.CurrentAlgorithm.Id;

        // show the "preparing" state and let it paint before the heavy recording starts
        _isPreparing = true;
        StateHasChanged();
        await Task.Yield();

        // Keep a clone of the original (unsorted) data for an isolated timing pass below.
        var timingClone = _arrayElements.Select(e => e.Clone()).ToList();

        // 1. Record the whole sort on the real elements (yields to the UI periodically).
        //    This also warms up the sort code path before we measure it.
        SortAlgorithm.SortService.StartRecording(_arrayElements.Cast<ISvgElement>());
        await SortAlgorithm.Sort(_arrayElements);
        SortAlgorithm.SortService.EndRecording();

        var frames = SortAlgorithm.SortService.Frames;

        // 2. Build the player and rewind to the starting arrangement.
        _player = new SortPlayer(
            _arrayElements.Cast<ISvgElement>().ToList(),
            SortAlgorithm.SortService.InitialStates,
            frames,
            userData.PlaybackSpeedMs);

        _isPreparing = false;
        _isRecorded = true;
        StateHasChanged();

        // 3. Timing pass: pure algorithm on the untouched clone, recording disabled,
        //    so the Stopwatch measures the real sort cost (not the recorder's diff work).
        SortAlgorithm.SortService.Silent = true;
        var sw = System.Diagnostics.Stopwatch.StartNew();
        await SortAlgorithm.Sort(timingClone);
        sw.Stop();
        SortAlgorithm.SortService.Silent = false;
        _computeMs = sw.Elapsed.TotalMilliseconds;

        // 4. Persist run stats — TimeWasted/SortTimeMs hold the real measured compute time.
        HistoryModel historyModel = new HistoryModel()
        {
            Id = ++indexDB.ObjectManager.CurrentMaxId,
            AlgorithmId = _algorithmId,
            ArrayAccessCount = SortAlgorithm.ArrayAccessCount,
            Delay = userData.PlaybackSpeedMs,
            MoveCount = SortAlgorithm.MoveCount,
            ElementsCount = _arrayElements.Count,
            TimeWasted = FormatMs(_computeMs),
            SortTimeMs = _computeMs,
            VisualizationType = VisualizationType.Line
        };

        await userData.AddHistory(historyModel, localStorage, indexDB);

        // 4. Play it back.
        await Play();
    }

    private async Task Play()
    {
        if (_player == null) return;

        // enable speed-synced sliding (only for sparse arrays), in two steps so switching
        // bars to the transform layout doesn't itself trigger a spurious glide:
        var animate = _arrayElements.Count <= AnimateMaxCount;
        _useTransform = animate;            // 1) lay bars out via transform (no transition yet)
        StateHasChanged();
        await Task.Yield();
        _animate = animate;                 // 2) now turn the transition on (transform unchanged)
        StateHasChanged();
        await Task.Yield();

        await IsSortingCallback.InvokeAsync();
        await _player.Play(() => InvokeAsync(StateHasChanged));
        await IsSortingCallback.InvokeAsync();

        _animate = false;
        _useTransform = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TogglePlay()
    {
        if (_player == null) return;

        if (_player.IsPlaying)
            _player.Pause();
        else
            await Play();
    }

    private void StopAnimating()
    {
        _animate = false;
        _useTransform = false;
    }

    private void StepForward()
    {
        StopAnimating();
        _player?.StepForward(() => InvokeAsync(StateHasChanged));
    }

    private void StepBack()
    {
        StopAnimating();
        _player?.StepBack(() => InvokeAsync(StateHasChanged));
    }

    private void Restart()
    {
        StopAnimating();
        _player?.Pause();
        _player?.Reset();
        StateHasChanged();
    }

    private void OnSeek(ChangeEventArgs e)
    {
        if (_player == null) return;

        StopAnimating();
        _player.Pause();
        if (int.TryParse(e.Value?.ToString(), out var target))
            _player.SeekTo(target);

        StateHasChanged();
    }

    public void Dispose()
    {
        _player?.Pause();
    }
}
